+test "c_api: set font family overwrites style-specific families" {
+    const testing = std.testing;
+    const alloc = testing.allocator;
+
+    var config = try Config.default(alloc);
+    defer config.deinit();
+
+    try config.@"font-family-bold".parseCLI(alloc, "Old Bold");
+    try config.@"font-family-italic".parseCLI(alloc, "Old Italic");
+
+    try testing.expect(ghostty_config_set_font_family(&config, "SF Mono", "SF Mono".len));
+    try testing.expectEqual(@as(u32, 1), ghostty_config_font_family_count(&config));
+    try testing.expectEqualStrings(
+        "SF Mono",
+        std.mem.sliceTo(ghostty_config_font_family_get(&config, 0).?, 0),
+    );
+    try testing.expectEqual(@as(usize, 0), config.@"font-family-bold".count());
+    try testing.expectEqual(@as(usize, 0), config.@"font-family-italic".count());
+    try testing.expectEqual(@as(usize, 0), config.@"font-family-bold-italic".count());
+}
+
+test "c_api: set font size clamps input" {
+    const testing = std.testing;
+    const alloc = testing.allocator;
+
+    var config = try Config.default(alloc);
+    defer config.deinit();
+
+    ghostty_config_set_font_size(&config, 0.5);
+    try testing.expectEqual(@as(f32, 1), config.@"font-size");
+
+    ghostty_config_set_font_size(&config, 512);
+    try testing.expectEqual(@as(f32, 255), config.@"font-size");
+}
