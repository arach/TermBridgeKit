 }
 
+fn config_set_font_family_(self: *Config, value: []const u8) !void {
+    const alloc = self._arena.?.allocator();
+
+    clearRepeatableString(&self.@"font-family");
+    clearRepeatableString(&self.@"font-family-bold");
+    clearRepeatableString(&self.@"font-family-italic");
+    clearRepeatableString(&self.@"font-family-bold-italic");
+
+    if (value.len == 0) return;
+
+    const copy = try alloc.dupeZ(u8, value);
+    try self.@"font-family".list.append(alloc, copy);
+}
+
+fn clearRepeatableString(value: *Config.RepeatableString) void {
+    value.list.clearRetainingCapacity();
+    value.overwrite_next = false;
+}
